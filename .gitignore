# Parent-level .gitignore for terra-api ecosystem
# This folder orchestrates multiple repos; individual repos have their own .gitignore files.

# Local-only orchestration secrets (never committed)
docker.env
*.pem

# Child repos — independent siblings, cloned separately per SETUP.md.
# NOT submodules: tracking them here commits bare gitlinks that clone as
# empty directories. See SETUP.md for the clone steps.
terra-api/
terra-api-fe/
terra-jenkins/
terra-hq-site/
oms/
restaurant-order-management-system/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local env overrides (if any)
.env.local

# Game Venture — separate Terra venture, pre-production, not part of terra-api's own repos.
# Coding not authorized here; folder exists locally for reference/planning only.
game venture/
